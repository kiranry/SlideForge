# Which AI backend to use: "gemini" (default) or "anthropic".
AI_PROVIDER=gemini

# --- Google Gemini (default provider) ---
# Get a key (free tier available) at https://aistudio.google.com/apikey
# gemini-2.5-flash-lite is reliable on the free tier; bump to
# gemini-2.5-flash or gemini-2.5-pro for higher quality if you have quota.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite
# Image generation model (same GOOGLE_API_KEY; requires paid/billing quota):
#   gemini-2.5-flash-image  — native Gemini images
#   imagen-4.0-generate-001 — higher quality Imagen
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image

# Free AI Studio keys have limit:0 for image models — set this to skip slow failures:
SKIP_GOOGLE_IMAGE=1

# Image provider:
#   auto (default) — Google (unless skipped) → Hugging Face → Pollinations
#   huggingface   — Hugging Face only (recommended on free Google keys)
#   gemini        — Google only
#   pollinations  — Pollinations only (often paywalled / HTTP 402)
IMAGE_PROVIDER=auto

# Recommended for free Google keys — HF Inference free monthly credits:
# https://huggingface.co/settings/tokens (create a token with "Inference" access)
HUGGINGFACE_API_KEY=
# HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# --- Anthropic (only needed if AI_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional client timing logs (generate/export) in browser console + localStorage
# NEXT_PUBLIC_TELEMETRY=1
